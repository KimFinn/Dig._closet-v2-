# Copy this file to .env and fill in real values. Never commit .env.
# Generated for Phase 0 — no .env.example existed before; this documents
# every env var actually read by the codebase (grepped for
# `process.env.*` across src/), grouped by what breaks without it.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database (PostgreSQL — required, the app cannot boot past
# sequelize.authenticate() without a reachable database). After setting
# these, run `npm run seed` once to create the schema (migrate + seed —
# seeding is currently a no-op, see src/database/seeders/README.md).
# ---------------------------------------------------------------------------
DB_NAME=wardrobe_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis — used by: the clothing-tagging queue (src/queues/taggingQueue.js),
# the weather cache (services/weather.service.js), the refresh-token
# allowlist (utils/tokens.js), and the ad-hoc read caches in
# clothes.controller.js / outfit.controller.js / outfitEngine.js.
# Required for uploads and login/refresh to work; the app itself still
# boots without Redis reachable, but those features will error at call time.
# ---------------------------------------------------------------------------
REDIS_CLOUD_HOST=127.0.0.1
REDIS_CLOUD_PORT=6379
REDIS_CLOUD_PASSWORD=
# Set to 'true' only for a managed/cloud Redis that actually requires
# TLS (e.g. Redis Cloud). Leave false/unset for a plain local dev Redis
# (Docker, WSL, etc.) — forcing TLS against one that doesn't speak it
# doesn't fail fast, it hangs/retries forever on every cache call.
REDIS_TLS=true

# ---------------------------------------------------------------------------
# Auth / JWT (required — JWT_SECRET falls back to an insecure dev default
# if unset, which is fine locally but must be set in any shared environment)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# Recommended: a separate secret so an access token can never be replayed
# as a refresh token or vice versa. Falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Set to 'true' to bypass auth entirely in local dev — never set this
# outside your own machine.
DISABLE_AUTH=false

# ---------------------------------------------------------------------------
# OAuth (Google / Apple sign-in — services/oauth.service.js). Frontend
# uses each provider's own native SDK to sign the user in and hands this
# API the resulting ID token (POST /api/v1/auth/google or /apple with
# { idToken }); the backend verifies it against these client/bundle IDs
# and issues the app's normal access+refresh token pair. Without these
# set, both endpoints reject every request at boot-adjacent config-check
# time rather than silently accepting unverifiable tokens.
# ---------------------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (the Web/iOS/Android client ID(s) your frontend uses to sign
# in) — comma-separated if you have more than one (e.g. iOS + Android).
GOOGLE_CLIENT_ID=
# Your app's bundle ID / Services ID as registered in the Apple Developer
# portal (Certificates, Identifiers & Profiles) — this is the `aud`
# claim Apple puts in the identity token. Requires a paid Apple
# Developer Program membership to set up on Apple's side; that
# enrollment/configuration is external to this codebase.
APPLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# CORS (required in production — server.js refuses to boot in production
# with this unset; falls back to localhost dev ports otherwise)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g.:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Vision APIs (fashion tagging — services/fashionTagger.js). At least the
# primary provider's key is required for uploads to actually get tagged;
# without any of these, tagging jobs will fail and items stay
# needsManualReview.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Cloudinary (image storage — required for any upload to work)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Weather (services/weather.service.js). Optional — if unset, weather
# calls log a warning and fall back to seasonal-average data instead of
# live forecasts (this used to crash the whole app at boot; see Phase 0
# fix in weather.service.js).
# ---------------------------------------------------------------------------
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Email (Phase 2 — services/notification.service.js, queues/checkInQueue.js).
# Used for the daily "did you wear it?" check-in email. Optional in the
# sense that the app boots fine without it -- with RESEND_API_KEY unset,
# the check-in job just logs what it would have sent instead of sending,
# same graceful-degradation pattern as the weather API above.
#
# Sign up at https://resend.com (free tier: 100 emails/day, 3,000/month —
# no card required, scales to a paid plan later with the same API/key).
# RESEND_FROM_EMAIL must be an address on a domain you've verified in
# Resend, OR left unset to use their shared onboarding@resend.dev sender
# for development (that one can only send to your own Resend account
# email, not real users — fine for testing, not for production).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Used to build the "log today's outfit" link in the check-in email.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Phase 2 — learning loop / daily check-in scheduling. All optional;
# sensible defaults are baked in (both jobs run once daily). Cron
# expressions are evaluated in the server process's local time (UTC in
# most deployments).
# ---------------------------------------------------------------------------
# Nightly job that runs NeuralPreferenceLearner.learnUserPreferences()
# for every "active" user (see PREFERENCE_LEARNING_ACTIVE_WINDOW_DAYS).
PREFERENCE_LEARNING_CRON=0 2 * * *
# A user counts as "active" for the nightly run if they've logged at
# least one interaction within this many days -- keeps the nightly job's
# DB cost proportional to real usage instead of scanning every account
# that ever signed up.
PREFERENCE_LEARNING_ACTIVE_WINDOW_DAYS=30
# How many users' learnUserPreferences() calls run at once during the
# nightly pass.
PREFERENCE_LEARNING_CONCURRENCY=5
# Daily check-in email job.
DAILY_CHECKIN_CRON=0 19 * * *
# Hard cap on how many check-in emails one run will send, regardless of
# how many users are eligible -- a safety net so a bug in the eligibility
# query can't burn through Resend's daily/monthly quota in one run.
DAILY_CHECKIN_MAX_EMAILS=500

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# How many tagging jobs src/workers/taggingWorker.js processes in parallel.
TAGGING_WORKER_CONCURRENCY=3
