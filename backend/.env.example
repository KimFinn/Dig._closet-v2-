# Copy this file to .env and fill in real values. Never commit .env.
# Generated for Phase 0 — no .env.example existed before; this documents
# every env var actually read by the codebase (grepped for
# `process.env.*` across src/), grouped by what breaks without it.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database (PostgreSQL — required, the app cannot boot past
# sequelize.authenticate() without a reachable database). After setting
# these, run `npm run seed` once to create the schema (migrate + seed —
# seeding is currently a no-op, see src/database/seeders/README.md).
# ---------------------------------------------------------------------------
DB_NAME=wardrobe_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional — database used when NODE_ENV=test (database/config/config.js).
# Defaults to `${DB_NAME}_test` if unset, so you only need to set this if
# you want the test DB to have a name unrelated to DB_NAME.
DB_NAME_TEST=

# ---------------------------------------------------------------------------
# Redis — used by: the clothing-tagging queue (src/queues/taggingQueue.js),
# the weather cache (services/weather.service.js), the refresh-token
# allowlist (utils/tokens.js), and the ad-hoc read caches in
# clothes.controller.js / outfit.controller.js / outfitEngine.js.
# Required for uploads and login/refresh to work; the app itself still
# boots without Redis reachable, but those features will error at call time.
# ---------------------------------------------------------------------------
REDIS_CLOUD_HOST=127.0.0.1
REDIS_CLOUD_PORT=6379
REDIS_CLOUD_PASSWORD=
# Set to 'true' only for a managed/cloud Redis that actually requires
# TLS (e.g. Redis Cloud). Leave false/unset for a plain local dev Redis
# (Docker, WSL, etc.) — forcing TLS against one that doesn't speak it
# doesn't fail fast, it hangs/retries forever on every cache call.
REDIS_TLS=true

# ---------------------------------------------------------------------------
# Auth / JWT (required — JWT_SECRET falls back to an insecure dev default
# if unset, which is fine locally but must be set in any shared environment)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# Recommended: a separate secret so an access token can never be replayed
# as a refresh token or vice versa. Falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Set to 'true' to bypass auth entirely in local dev — never set this
# outside your own machine.
DISABLE_AUTH=false

# ---------------------------------------------------------------------------
# OAuth (Google / Apple sign-in — services/oauth.service.js). Frontend
# uses each provider's own native SDK to sign the user in and hands this
# API the resulting ID token (POST /api/v1/auth/google or /apple with
# { idToken }); the backend verifies it against these client/bundle IDs
# and issues the app's normal access+refresh token pair. Without these
# set, both endpoints reject every request at boot-adjacent config-check
# time rather than silently accepting unverifiable tokens.
# ---------------------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (the Web/iOS/Android client ID(s) your frontend uses to sign
# in) — comma-separated if you have more than one (e.g. iOS + Android).
GOOGLE_CLIENT_ID=
# Your app's bundle ID / Services ID as registered in the Apple Developer
# portal (Certificates, Identifiers & Profiles) — this is the `aud`
# claim Apple puts in the identity token. Requires a paid Apple
# Developer Program membership to set up on Apple's side; that
# enrollment/configuration is external to this codebase.
APPLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# CORS (required in production — server.js refuses to boot in production
# with this unset; falls back to localhost dev ports otherwise)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g.:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Vision APIs (fashion tagging — services/fashionTagger.js). At least the
# primary provider's key is required for uploads to actually get tagged;
# without any of these, tagging jobs will fail and items stay
# needsManualReview.
#
# ANTHROPIC_API_KEY is also reused by Phase 7's budget feasibility
# narration (services/budgetFeasibility.service.js) — same key, second
# use. Unset, feasibility checks still return a fully correct answer,
# just a plain templated sentence instead of LLM-narrated phrasing (see
# the Phase 7 section below); tagging is the one feature that actually
# needs this key set to do its job.
# GOOGLE_CREDENTIALS_PATH also gets mirrored into
# GOOGLE_APPLICATION_CREDENTIALS at runtime (fashionTagger.js) — that's
# the exact env var name Google's own SDK looks for; you only ever need
# to set GOOGLE_CREDENTIALS_PATH here.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Cloudinary (image storage — required for any upload to work)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Weather (services/weather.service.js). Optional — if unset, weather
# calls log a warning and fall back to seasonal-average data instead of
# live forecasts (this used to crash the whole app at boot; see Phase 0
# fix in weather.service.js).
# ---------------------------------------------------------------------------
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Email (Phase 2 — services/notification.service.js, queues/checkInQueue.js).
# Used for the daily "did you wear it?" check-in email. Optional in the
# sense that the app boots fine without it -- with RESEND_API_KEY unset,
# the check-in job just logs what it would have sent instead of sending,
# same graceful-degradation pattern as the weather API above.
#
# Sign up at https://resend.com (free tier: 100 emails/day, 3,000/month —
# no card required, scales to a paid plan later with the same API/key).
# RESEND_FROM_EMAIL must be an address on a domain you've verified in
# Resend, OR left unset to use their shared onboarding@resend.dev sender
# for development (that one can only send to your own Resend account
# email, not real users — fine for testing, not for production).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Used to build the "log today's outfit" link in the check-in email.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Phase 2 — learning loop / daily check-in scheduling. All optional;
# sensible defaults are baked in (both jobs run once daily). Cron
# expressions are evaluated in the server process's local time (UTC in
# most deployments).
# ---------------------------------------------------------------------------
# Nightly job that runs NeuralPreferenceLearner.learnUserPreferences()
# for every "active" user (see PREFERENCE_LEARNING_ACTIVE_WINDOW_DAYS).
PREFERENCE_LEARNING_CRON=0 2 * * *
# A user counts as "active" for the nightly run if they've logged at
# least one interaction within this many days -- keeps the nightly job's
# DB cost proportional to real usage instead of scanning every account
# that ever signed up.
PREFERENCE_LEARNING_ACTIVE_WINDOW_DAYS=30
# How many users' learnUserPreferences() calls run at once during the
# nightly pass.
PREFERENCE_LEARNING_CONCURRENCY=5
# Daily check-in email job.
DAILY_CHECKIN_CRON=0 19 * * *
# Hard cap on how many check-in emails one run will send, regardless of
# how many users are eligible -- a safety net so a bug in the eligibility
# query can't burn through Resend's daily/monthly quota in one run.
DAILY_CHECKIN_MAX_EMAILS=500

# ---------------------------------------------------------------------------
# Phase 3 — trip maintenance: nightly auto-replan on forecast drift +
# forecast-accuracy backfill (queues/tripMaintenanceQueue.js). All
# optional; sensible defaults are baked in. Historical/actual weather
# (services/historicalWeather.service.js) uses Open-Meteo, which needs no
# API key at all -- nothing to configure there.
# ---------------------------------------------------------------------------
TRIP_MAINTENANCE_CRON=0 3 * * *
# Only trips starting within this many days (or already active) get their
# forecast re-checked -- a trip months out only ever has a climate-average
# estimate to compare against itself, so checking it would just spend API
# calls for no signal.
TRIP_REPLAN_LOOKAHEAD_DAYS=7
# Temperature swing (°C) between the stored forecast and a freshly
# re-fetched one that counts as worth regenerating the packing list over.
TRIP_REPLAN_DRIFT_TEMP_C=5
# Safety cap: at most this many trips get a forecast re-check in one run.
TRIP_REPLAN_MAX_PER_RUN=200
# How many days in the past a trip-day can be and still get a
# forecast-accuracy check (bounds both the query and the Open-Meteo call
# volume -- each trip-day is only ever checked once anyway, this just
# stops retrying forever if the data never becomes available).
WEATHER_OUTCOME_LOOKBACK_DAYS=7
# Safety cap: at most this many forecast-accuracy checks in one run.
WEATHER_OUTCOME_MAX_PER_RUN=500

# ---------------------------------------------------------------------------
# Phase 5 — gap-to-purchase funnel (affiliate strategy). All optional;
# everything works end to end in "mock" mode with none of these set,
# same credential-gated pattern as WEATHER_API_KEY — a mock/untracked
# affiliate link and a local mock product feed are used until you have
# a real aggregator account.
# ---------------------------------------------------------------------------
# Skimlinks (or whichever aggregator you sign up with — this app's v1
# affiliate-link wrap is Skimlinks-shaped, see services/affiliateLink.
# service.js) publisher ID. Flips affiliate links from a mock/untracked
# wrap to a real tracked one; also gates affiliateConversion.service.js's
# nightly network-conversion reconciliation.
SKIMLINKS_PUBLISHER_ID=
# How many days of shipping lead time a gap-purchase suggestion needs to
# arrive before it's needed — a gap detected with less time than this
# left is classified too_urgent and never gets a purchase link (see
# services/gapUrgency.service.js).
GAP_SHIPPING_LEAD_TIME_DAYS=7
# Nightly job (queues/gapPurchaseFollowupQueue.js): reconciles affiliate
# network conversions and sends a "did you end up buying it?" self-report
# check-in for clicks that haven't confirmed either way.
GAP_PURCHASE_FOLLOWUP_CRON=0 6 * * *
# How many hours after a gap-purchase link is clicked before the
# self-report check-in email is eligible to send.
GAP_PURCHASE_CHECKIN_DELAY_HOURS=24
# Safety cap: at most this many self-report check-in emails in one run.
GAP_PURCHASE_CHECKIN_MAX_EMAILS=500
# Nightly job (queues/productFeedIngestionQueue.js) that ingests the
# local mock product feed (services/productFeed.service.js) into the
# product_feed_items table — a real affiliate feed is a bulk download,
# not a live per-request search API, so this is always a scheduled
# ingest job, mock or real.
PRODUCT_FEED_INGESTION_CRON=0 4 * * *

# ---------------------------------------------------------------------------
# Phase 7 — Trip Activities, Places, Destination Intelligence &
# Budgeting. All optional; every piece works end to end without any of
# these set (mock places, FCDO-only advisory chain, templated budget
# verdicts) and switches to the live/fuller behavior the moment the
# corresponding credential exists — no other code changes needed.
# ---------------------------------------------------------------------------
# Google Places (services/places.service.js) — gates real place search/
# details lookups (Mode A leisure-fill, the too-urgent gap's nearby-store
# pointer). Deterministic mock places are used without it. See that
# file's module doc for exactly how caching is scoped to Google's actual
# ToS (place_id/coordinates cached permanently, full details only a short
# ~1hr operational cache — do not extend that TTL, it isn't a duration
# Google's terms have an exception for).
PLACES_API_KEY=
# Model used for budget feasibility's LLM narration step (see the note
# on ANTHROPIC_API_KEY above — that's the actual gating credential, this
# just picks the model).
BUDGET_FEASIBILITY_MODEL=claude-3-5-haiku-20241022
# Hourly job (queues/budgetReminderQueue.js) that dispatches "remind me
# to buy X while there" reminders once their trip/outing is active or
# their specific date arrives.
BUDGET_REMINDER_CRON=0 * * * *
# Daily job (queues/destinationAdvisoryQueue.js) that refreshes travel
# advisories for every active/upcoming trip's country.
DESTINATION_ADVISORY_CRON=0 5 * * *
# 2nd/3rd sources in the FCDO -> Canada -> Smartraveller advisory
# fallback chain (services/destinationAdvisory.service.js). FCDO (GOV.UK
# Content API) needs no key and is always tried first; these two are
# deliberately left unset by default rather than pointed at a guessed,
# unverified endpoint — set them only once you've confirmed the real
# resource ID / feed URL for each. Every source in this chain uses
# deterministic keyword/field parsing only, never an LLM, for
# safety-advisory data; if all three fail, the app returns an honest
# "temporarily unavailable" message rather than fabricating a risk level.
CANADA_ADVISORY_RESOURCE_ID=
SMARTRAVELLER_RSS_BASE_URL=

# ---------------------------------------------------------------------------
# Phase 9 — Digital Life-Twin & Grounded Chatbot (PRD §3.10). All
# optional; the profile still synthesizes and the chatbot still answers
# (via a plain templated fallback) with none of these set -- ANTHROPIC_API_KEY
# is the one credential that upgrades narrative/chatbot phrasing from
# templated to LLM-narrated, same reused key as budget feasibility above.
# ---------------------------------------------------------------------------
# Nightly job (queues/profileSynthesisQueue.js) that recomputes every
# active user's structured_traits across all four trait pillars.
PROFILE_SYNTHESIS_CRON=30 2 * * *
# How many users' synthesizeProfileForUser() calls run at once during
# the nightly pass.
PROFILE_SYNTHESIS_CONCURRENCY=5
# How many consecutive nightly runs a freshly-computed inferred_preference
# trait has to keep diverging from a user's override/delete correction
# before that correction is cleared and the trait is re-proposed fresh
# (2026-09-18 scoping decision -- a real, sustained reversal, not noisy
# short-term signal). Does not apply to observed_fact traits (suppression
# there is permanent until the user restores it themselves) or to
# scope_only corrections (never a dispute, never auto-cleared).
PROFILE_REVERSAL_STREAK_NIGHTS=14
# Nightly job (same queue) purging raw UserInteraction rows older than
# this many days -- resolves PRD §8 item 4 (2026-09-18). Does NOT touch
# UserProfileSummary itself, which persists indefinitely.
INTERACTION_PURGE_CRON=0 3 * * *
INTERACTION_RETENTION_DAYS=90
# Model used for the profile narrative's LLM phrasing step
# (services/profileNarrative.service.js).
PROFILE_NARRATIVE_MODEL=claude-3-5-haiku-20241022
# Model used for the grounded chatbot's answers (services/chatbot.service.js).
PROFILE_CHATBOT_MODEL=claude-3-5-haiku-20241022
# Confidence-aware gate: below this, the chatbot says "not enough data
# yet" instead of calling the LLM at all, for that turn.
CHATBOT_MIN_CONFIDENCE=0.3

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# How many tagging jobs src/workers/taggingWorker.js processes in parallel.
TAGGING_WORKER_CONCURRENCY=3
