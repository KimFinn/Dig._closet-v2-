{
  "name": "wardrobe-system-backend",
  "version": "1.0.0",
  "description": "Wardrobe System - Node.js Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/taggingWorker.js",
    "worker:dev": "nodemon src/workers/taggingWorker.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "seed": "npm run db:migrate && npm run db:seed",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "wardrobe",
    "outfit-recommendation",
    "trip-planning",
    "closet"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@google-cloud/vision": "^6.1.0",
    "apple-signin-auth": "^2.1.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "openai": "^7.16.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.4",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
